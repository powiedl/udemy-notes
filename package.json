{
  "name": "udemy-notes",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "vercel-build": "prisma generate && prisma migrate deploy && pnpm run build",
    "build": "vite build",
    "build:local": "dotenv -e .env.production.local pnpm run build",
    "start:local": "node --env-file=.env.production.local .output/server/index.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "lint": "eslint",
    "format": "prettier --check .",
    "check": "prettier --write . && eslint --fix",
    "post-cta-init": "npx -y create-db@latest --user-agent tanstack/tsrouter",
    "prod:db:generate": "dotenv -e .env.production.local -- prisma generate",
    "prod:db:deploy": "dotenv -e .env.production.local -- prisma migrate deploy",
    "prod:db:studio": "dotenv -e .env.production.local -- prisma studio",
    "prod:db:seed": "dotenv -e .env.production.local -- prisma db seed",
    "db:generate": "dotenv -e .env.development.local -- prisma generate",
    "db:push": "dotenv -e .env.development.local -- prisma db push",
    "db:migrate": "dotenv -e .env.development.local -- prisma migrate dev",
    "db:studio": "dotenv -e .env.development.local -- prisma studio",
    "db:push:force": "dotenv -e .env.development.local -- prisma db push --force-reset",
    "db:seed": "dotenv -e .env.development.local -- prisma db seed",
    "db:cleanup-trainers": "dotenv -e .env.development.local -- tsx src/scripts/cleanup-trainers.ts"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@hugeicons/core-free-icons": "^4.2.3",
    "@hugeicons/react": "^1.1.9",
    "@mdxeditor/editor": "^4.0.4",
    "@openrouter/sdk": "^0.13.65",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-devtools": "latest",
    "@tanstack/react-form": "^1.33.3",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-router": "latest",
    "@tanstack/react-router-devtools": "latest",
    "@tanstack/react-router-ssr-query": "latest",
    "@tanstack/react-start": "latest",
    "@tanstack/router-plugin": "^1.168.23",
    "@tanstack/zod-adapter": "^1.167.0",
    "better-auth": "^1.6.23",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.25.0",
    "nitro": "3.0.260610-beta",
    "pnpm": "^11.15.0",
    "prisma": "^7.9.1",
    "prismjs": "^1.30.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "shadcn": "^4.13.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "uuid": "^14.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.20",
    "@tanstack/devtools-vite": "latest",
    "@tanstack/eslint-config": "latest",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.1.2",
    "@types/prismjs": "^1.26.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "dotenv-cli": "^11.0.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.6",
    "tsx": "^4.23.4",
    "typescript": "^6.0.3",
    "vite": "^8.1.5",
    "vitest": "^4.1.10",
    "vitest-mock-extended": "^4.0.0"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
